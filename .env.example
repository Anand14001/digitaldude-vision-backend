# ---- Core ----
NODE_ENV=development
PORT=4001
API_URL=http://localhost:4001

# ---- Database ----
DATABASE_URL="postgresql://crm:crm_local_password@localhost:5433/digital_dude_crm?schema=public"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost

# ---- CORS (comma separated) ----
WEB_ORIGINS=http://localhost:5173
PORTAL_PATH=/portal

# ---- Files: cloudinary | s3 | local ----
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (SMTP; leave blank to log emails to console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Dude CRM <no-reply@digital-dude.com>"

# ---- Seed bootstrap admin ----
SEED_ADMIN_EMAIL=admin@digital-dude.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_DEMO_DATA=true
