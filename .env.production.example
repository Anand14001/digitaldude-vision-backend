# Production configuration. Copy to the host's environment (Railway, Render,
# Fly, a VPS) rather than committing real values anywhere.

NODE_ENV=production
PORT=4000
API_URL=https://api.digital-dude.com

# ---- Database ----
# Prisma Postgres gives a pooled connection string. Migrations are run from a
# machine or CI step that can reach it:
#   DATABASE_URL="<pooled url>" npx prisma migrate deploy
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# ---- Auth ----
# Generate fresh values; never reuse the development ones.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# The domain the refresh cookie is scoped to. With the API and the SPA on
# different subdomains, use the shared parent (e.g. .digital-dude.com).
COOKIE_DOMAIN=.digital-dude.com

# ---- CORS: the exact origins the SPA is served from ----
WEB_ORIGINS=https://crm.digital-dude.com

# ---- Files ----
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Dude CRM <no-reply@digital-dude.com>"

# ---- First administrator ----
# Used once by `npm run db:seed`; remove the password afterwards.
SEED_ADMIN_EMAIL=admin@digital-dude.com
SEED_ADMIN_PASSWORD=
# Never seed demo clients and staff into a real database.
SEED_DEMO_DATA=false
